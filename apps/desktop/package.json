{
  "name": "@moonc/desktop",
  "productName": "MoonlightC",
  "version": "0.6.50",
  "private": true,
  "description": "Every AI in one place, with your own keys.",
  "author": "MoonlightC contributors",
  "license": "MIT",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "electron .",
    "bundle-web": "node scripts/bundle-web.mjs",
    "dist": "pnpm bundle-web && electron-builder --publish never",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test src/safety.test.mjs"
  },
  "dependencies": {
    "@jitsi/robotjs": "0.6.24",
    "koffi": "3.3.2",
    "node-pty": "1.1.0",
    "systeminformation": "5.33.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.5",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/robertpierson/moonlightc.git"
  },
  "homepage": "https://moonlightc.vercel.app",
  "build": {
    "appId": "app.moonlightc.desktop",
    "productName": "MoonlightC",
    "artifactName": "MoonlightC-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/**/*.test.mjs",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app-server",
        "to": "app-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/koffi/**"
    ],
    "protocols": [
      {
        "name": "MoonlightC",
        "schemes": [
          "moonlightc"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "MoonlightC-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "MoonlightC contributors"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "robertpierson",
        "repo": "moonlightc",
        "releaseType": "draft"
      }
    ],
    "npmRebuild": false,
    "extraMetadata": {
      "name": "moonlightc"
    }
  }
}
